{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chaos",
  "identifier": "xyz.tdbm.chaos",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../chaos-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xyz.tdbm.chaos"]
      },
      "mobile": [
        {
          "scheme": ["xyz.tdbm.chaos"],
          "host": "auth"
        }
      ]
    }
  }
}
